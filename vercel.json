{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "apps/agent/public",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${SECOND_BRAIN_API}/api/$1",
      "env": ["SECOND_BRAIN_API"]
    }
  ]
}
