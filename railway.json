{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "language": "nodejs",
      "nodeVersion": "24"
    }
  },
  "deploy": {
    "startCommand": "node --experimental-strip-types apps/hq/server.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
