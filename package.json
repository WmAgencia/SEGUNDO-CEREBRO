{
  "name": "second-brain-os",
  "version": "0.1.0",
  "description": "Local-first personal knowledge infrastructure and shared memory for AI agents.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.4.0"
  },
  "bin": {
    "brain": "apps/cli/bin/brain.js",
    "second-brain-mcp": "mcp/bin/second-brain-mcp.js"
  },
  "scripts": {
    "cli": "node apps/cli/src/main.ts",
    "brain": "node apps/cli/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node mcp/src/main.ts",
    "mcp:smoke": "node scripts/mcp-smoke.cjs",
    "llama:serve": "scripts\\llama-serve.cmd",
    "ai:status": "node apps/cli/src/main.ts ai:status",
    "hq": "node --experimental-strip-types apps/hq/server.ts",
    "agent": "node --experimental-strip-types apps/agent/server.ts",
    "clipcon:server": "tsx apps/clipcon-server/server.ts",
    "clipcon:web": "npm --prefix apps/clipcon-web run dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.0",
    "ws": "^8.21.3",
    "yaml": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
