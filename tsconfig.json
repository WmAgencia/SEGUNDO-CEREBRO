{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "apps/cli/src/**/*.ts",
    "core/**/*.ts",
    "storage/**/*.ts",
    "connectors/**/*.ts",
    "mcp/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
